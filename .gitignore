checkpoints/
go1-*/
**/checkpoints/
*.ckpt

# Logs
*.log

# Trajectories (intermediate, regenerate with nav_obstacle.py)
*.npz

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Large binaries: only videos/ is excepted
*.mp4
!videos/
!videos/**
*.bin
*.onnx

